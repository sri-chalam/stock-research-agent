meta {
  name: Filings Get Filings Info
  type: http
  seq: 11
}

post {
  url: {{hostname}}/api/chat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  @description('UUID')
  X-Correlation-Id: {{$randomUUID}}
  @description('UUID')
  X-Trace-Id: {{$randomUUID}}
}

body:json {
  {
    "message":"List Apple's most recent 10-K filings"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
