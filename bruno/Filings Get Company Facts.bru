meta {
  name: Filings Get Company Facts
  type: http
  seq: 13
}

post {
  url: {{hostname}}/api/chat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  @description('UUID')
  X-Correlation-Id: {{$randomUUID}}
}

body:json {
  {
    "message": "Show Microsoft's net income, diluted EPS and cash for the last 3 fiscal years."
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
