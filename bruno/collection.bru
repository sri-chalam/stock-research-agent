auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{oauthCallbackUrl}}
  authorization_url: {{workosAuthorizeUrl}}
  access_token_url: {{workosTokenUrl}}
  refresh_token_url: 
  client_id: {{workosClientId}}
  client_secret: 
  scope: 
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: credentials
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

docs {
  WorkOS AuthKit sign-in (Authorization Code + PKCE, public client: no client secret).
  Setup: copy bruno/.env.example to bruno/.env, set WORKOS_CLIENT_ID, select the `local` environment,
  then Collection settings → Auth → Get Access Token and sign in as a demo user.
  To switch users, clear the stored credentials and fetch a new token.
}
