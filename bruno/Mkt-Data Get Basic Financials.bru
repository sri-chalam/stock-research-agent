meta {
  name: Mkt-Data Get Basic Financials
  type: http
  seq: 9
}

post {
  url: {{hostname}}/api/chat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  @description('UUID')
  X-Correlation-Id: {{$randomUUID}}
}

body:json {
  {
    "message":"When does UPS report earnings in the next 3 months, and what EPS is expected?"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
