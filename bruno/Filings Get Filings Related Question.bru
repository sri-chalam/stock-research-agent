meta {
  name: Filings Get Filings Related Question
  type: http
  seq: 12
}

post {
  url: {{hostname}}/api/chat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  @description('UUID')
  X-Correlation-Id: {{$randomUUID}}
  @description('UUID')
  X-Trace-Id: {{$randomUUID}}
}

body:json {
  {
    "message":"When did NVDA file its last three 8-Ks?"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
