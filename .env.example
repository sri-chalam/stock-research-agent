# Copy to .env (git-ignored) and fill in. Docker Compose reads .env for docker-compose.yml.
# Each key is passed only to the service that needs it.

# market-data-mcp. Free key at https://finnhub.io
FINNHUB_API_KEY=

# filings-mcp. SEC EDGAR requires a User-Agent with contact details,
# e.g. "stock-research-agent you@example.com".
SEC_USER_AGENT=
# Optional: Postgres passwords. docker-compose.yml has local-dev defaults. Run filings-mcp with
# bootRun against the Compose Postgres by exporting FILINGS_DB_PASSWORD (default filings-local-dev).
# POSTGRES_PASSWORD=
# FILINGS_DB_PASSWORD=

# agent-app
ANTHROPIC_API_KEY=
