# Copy to .env (git-ignored) and fill in. Docker Compose reads .env for docker-compose.yml.
# Each key is passed only to the service that needs it.

# market-data-mcp. Free key at https://finnhub.io
FINNHUB_API_KEY=

# filings-mcp. SEC EDGAR requires a User-Agent with contact details,
# e.g. "stock-research-agent you@example.com".
SEC_USER_AGENT=
# Optional: Postgres passwords. docker-compose.yml has local-dev defaults. Run filings-mcp with
# bootRun against the Compose Postgres by exporting FILINGS_DB_PASSWORD (default filings-local-dev).
# POSTGRES_PASSWORD=
# FILINGS_DB_PASSWORD=
# portfolio-mcp: run it with bootRun against the Compose Postgres by exporting
# PORTFOLIO_DB_PASSWORD (default portfolio-local-dev).
# PORTFOLIO_DB_PASSWORD=
# agent-app's semantic cache: run it with bootRun against the Compose Postgres by exporting
# SEM_CACHE_DB_PASSWORD (default sem-cache-local-dev).
# SEM_CACHE_DB_PASSWORD=

# agent-app
ANTHROPIC_API_KEY=

# WorkOS token validation (agent-app and all three MCP servers). Copy the issuer exactly from a real access
# token's `iss` claim; its client ID can differ from the token's `client_id` claim.
WORKOS_ISSUER_URI=https://api.workos.com/user_management/
WORKOS_JWK_SET_URI=https://api.workos.com/sso/jwks/

# agent-app's chat page at http://localhost:8080/ signs in with authkit-js. WorkOS dashboard →
# Applications → your app → Client ID (client_...). Public, not a secret.
WORKOS_CLIENT_ID=

# WorkOS demo users (ticket 02). Their `sub` values (user_...) from WorkOS dashboard → Users.
# portfolio-mcp seeds a demo portfolio for each (Iteration 5).
WORKOS_DEMO_USER_1_SUB=
WORKOS_DEMO_USER_2_SUB=

# Optional: WorkOS test users that Claude signs in as (scripts/workos-token.sh). Their `sub`
# values (user_...); portfolio-mcp seeds them with copies of demo user 1's and 2's portfolios.
# Leave blank to skip. Their emails, passwords and WORKOS_API_KEY stay out of this file
# (set them in your shell environment).
CLAUDE_TEST_USER_1_SUB=
CLAUDE_TEST_USER_2_SUB=
