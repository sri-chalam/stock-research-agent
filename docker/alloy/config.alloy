// Ships every container's stdout in this Compose project to Loki (ADR 0011).
// Labels: `service` (compose service name) for every container, `level` for JSON log lines only.

discovery.docker "compose" {
  host = "unix:///var/run/docker.sock"

  // Only this project's containers, not everything else on the Docker host.
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

discovery.relabel "compose" {
  targets = discovery.docker.compose.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "compose" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.compose.output
  relabel_rules = discovery.relabel.compose.rules
  forward_to    = [loki.process.level.receiver]
}

// The apps log one JSON object per line with "level" as emitted (e.g. INFO). Plain-text lines
// (Postgres, Spring banner, Loki/Alloy/Grafana logfmt) fail the JSON stage and get no level label.
loki.process "level" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
